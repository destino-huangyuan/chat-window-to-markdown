# Publish only reviewed files. Private fixtures remain local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/requirements.txt
!/wechat_chat_exporter.py
!/windows_ocr.ps1
!/开始导出微信聊天.bat
!/打开导出结果.bat
!/diagnose_ocr.bat
!/install_dependencies.bat
!/使用说明.txt
!/docs/
/docs/*
!/docs/OCR_ADAPTER.md
!/docs/TROUBLESHOOTING.md
!/docs/PRIVACY.md
!/docs/GIT_RELEASE_CHECKLIST.md
!/docs/THIRD_PARTY.md
!/examples/
/examples/*
!/examples/sample_chat.md
!/examples/sample_quality_report.md
!/examples/README.md
!/examples/sample_input.json
!/导出结果/
/导出结果/*
!/导出结果/.gitkeep

# Ignore rules never remove already tracked files.
**/__pycache__/
*.py[cod]
*.log
*.tmp
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.zip
.env
.env.*
.venv/
venv/
config.json
work/
tests/
.DS_Store
Thumbs.db
